rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Public read for shelters, alerts, and verified facilities (needed for citizen safety map)
    match /shelters/{shelterId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /alerts/{alertId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /agencies/{agencyId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Emergency incident reports: anyone can create (SOS), only auth can modify
    match /reports/{reportId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAuthenticated();
    }

    // Checkins: public create, read by phone/code
    match /checkins/{checkinId} {
      allow read, create: if true;
      allow update, delete: if isAuthenticated();
    }

    // Missing persons: public read and create
    match /missing_persons/{missingPersonId} {
      allow read, create: if true;
      allow update, delete: if isAuthenticated();
    }

    // Volunteers: public signup, authenticated manage
    match /volunteers/{volunteerId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAuthenticated();
    }

    // Admin users & audit logs: authenticated only
    match /admin_users/{userId} {
      allow read, write: if isAuthenticated();
    }

    match /audit_logs/{logId} {
      allow read, write: if isAuthenticated();
    }

    // Catch-all default
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
