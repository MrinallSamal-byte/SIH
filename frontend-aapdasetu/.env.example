# AapdaSetu Frontend Deployment Environment Configuration

# Backend API endpoint — the backend ORIGIN ROOT only, no /api suffix
# (endpoint paths already start with /api/v1/...).
# Local dev: http://localhost:4000
# Production (Vercel): set at build time to e.g. https://<api-project>.vercel.app
# If UNSET in a production build the app falls back to same-origin ('') —
# that only works behind a same-origin /api proxy; otherwise all reads show
# the "Demo mode" banner and writes fail honestly. Changing VITE_* requires
# a redeploy. See DEPLOYMENT.md.
VITE_API_URL=http://localhost:4000

# AI Services Engine endpoint (FastAPI Computer Vision / Triage)
VITE_AI_URL=http://localhost:8000

# WARNING: any VITE_* key below is bundled into client JS — prefer routing AI calls
# through the backend proxy instead of exposing provider keys here.
VITE_ZEN_API_KEY=
VITE_OPENROUTER_API_KEY=

# Optional: Supabase Realtime credentials (leave empty if using built-in realtime event bus fallback)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Set to true to enforce offline/demo mock scenario mode without a live backend
VITE_USE_MOCK_ONLY=false

# Optional: Custom Map Tile Provider (default: High-Definition Streets)
VITE_MAP_TILE_URL=https://mt{s}.google.com/vt/lyrs=m&x={x}&y={y}&z={z}
VITE_MAP_ATTRIBUTION=
