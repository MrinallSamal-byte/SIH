# =============================================================================
# AapdaSetu Frontend — Environment Variables & API Credentials
# -----------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values. Everything below is
# a PLACEHOLDER — the value in brackets is WHERE that credential is consumed.
#
# NEVER commit real secrets. `.env.local` is gitignored.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. BACKEND SERVERS (browser-side)
# -----------------------------------------------------------------------------

# Express REST backend base URL.
# Used by: src/api/client.ts -> buildUrl for every /api/* call
# @TODO BUILD: create the Express server described in src/api/endpoints.ts
VITE_API_URL=http://localhost:4000

# FastAPI AI engine base URL.
# Used by: src/api/ai.ts (triage, damage-assessment, satellite-flood-map)
VITE_AI_URL=http://localhost:8080

# OpenCode Zen API Key for AapdaMitra AI Companion (DeepSeek V4 Flash Free)
# Used by: src/api/ai.ts -> aiPfaChat
# Get a free key at https://opencode.ai/zen and put it in .env.local
# VITE_ZEN_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Legacy OpenRouter key (still honoured as fallback if VITE_ZEN_API_KEY is unset)
# VITE_OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# 2. SUPABASE (OPTIONAL — only if you swap polling for real WebSockets)
# -----------------------------------------------------------------------------

# Supabase project URL + anon key.
# Used by: src/hooks/useRealtime.ts (swap postgres_changes WebSocket) and
#          src/pages/admin/Login.tsx (replaces /api/admin/login with the
#          verify_admin_login() RPC). Leave blank to keep REST polling + login.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Force every API call to return in-memory mock data (demo mode). Set to "true".
# Used by: src/api/client.ts + src/api/ai.ts
VITE_USE_MOCK_ONLY=

# -----------------------------------------------------------------------------
# 3. MAP TILES (OPTIONAL)
# -----------------------------------------------------------------------------

# Leaflet tile layer URL + attribution. OSM is keyless and used by default.
# Used by: src/components/map/LeafletMap.tsx
# If you use Mapbox/Esri/etc., put the access token inside this URL string.
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# =============================================================================
# 4. SERVER-SIDE ONLY CREDENTIALS  (NEVER exposed to the browser bundle)
# -----------------------------------------------------------------------------
# These are NOT VITE_* vars. They are entered in the admin Settings view
# (src/pages/admin/Settings.tsx) and consumed by the EXPRESS backend only:
#
#   POST /api/communications/broadcast  (channel: sms)
#     - Twilio Account SID
#     - Twilio Auth Token
#
#   POST /api/communications/broadcast  (channel: whatsapp)
#     - WhatsApp Cloud API Token
#     - WhatsApp Phone Number ID
#
#   POST /api/admin/login  (server-side bcrypt compare)
#     - Admin email + bcrypt password hash (NOT plaintext)
#
# Placeholders below show the shape; store them on the server, never here.
# =============================================================================

# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# WHATSAPP_CLOUD_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# WHATSAPP_PHONE_NUMBER_ID=xxxxxxxxxxxx
# ADMIN_EMAIL=admin@aapdasetu.example
# ADMIN_PASSWORD_BCRYPT_HASH=$2b$12$...
