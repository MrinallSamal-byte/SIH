# Vercel Project: sih-backend (prj_4vNbYzXMgN5MC9dvGH5nmQMjBrrl)
# Target: Production + Preview  (set both!)
# How to use: Vercel Dashboard -> sih-backend -> Settings -> Environment Variables -> Add each KEY=VALUE, select Production+Preview, Save -> Redeploy
# After adding, Redeploy (or git push) — both projects must be redeployed.

# ---- Server ----
NODE_ENV=production
PORT=4000
HOST=0.0.0.0
VOLUNTEER_ACCESS_CODE=aapdasetu-dev-volunteer-code
# REQUIRED on Vercel — without TRUST_PROXY=1, express-rate-limit rejects every x-forwarded-for and API 500s
TRUST_PROXY=1
LOG_LEVEL=info

# ---- Database (PostgreSQL - Supabase AapdaSetu - ACTIVE SOLE DB) ----
# Transaction Pooler for serverless (Vercel):
DATABASE_URL=postgresql://aapdasetu_app.vpstgjkkvzqnspcivvpz:AapdaSetu2026Secure!@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true
# Direct connection for migrations:
DIRECT_URL=postgresql://aapdasetu_app:AapdaSetu2026Secure!@db.vpstgjkkvzqnspcivvpz.supabase.co:5432/postgres?sslmode=require


# ---- Admin authentication ----
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REPLACE_WITH_32_PLUS_RANDOM_HEX
JWT_EXPIRES_IN=12h
ADMIN_EMAIL=admin@aapdasetu.org
ADMIN_PASSWORD=Admin@123

# ---- OpenRouter (PFA LLM chatbot) ----
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
PFA_ESCAPE_MODE=strict

# ---- Damage Assessment ML Service (FastAPI) ----
# Leave empty if not hosted, or set to your HF/FastAPI URL
DAMAGE_ML_BASE_URL=
DAMAGE_ML_TIMEOUT_MS=30000

# ---- CORS ----
# MUST include your frontend domains — without this, browser blocks API calls
CORS_ORIGINS=https://aapdasetu-v3.vercel.app,https://sih-ochre-xi.vercel.app,https://sih-mrinallsamal-bytes-projects.vercel.app,https://sih-git-main-mrinallsamal-bytes-projects.vercel.app

# ---- Rate limiting ----
RATE_LIMIT_PUBLIC_WINDOW_MS=60000
RATE_LIMIT_PUBLIC_MAX=60
RATE_LIMIT_ADMIN_WINDOW_MS=900000
RATE_LIMIT_ADMIN_MAX=300

# ---- Realtime ----
REALTIME_PATH=/ws

# ---- Uploads ----
UPLOAD_MAX_SIZE_MB=15

# ---- Broadcast providers (OPTIONAL — leave empty to persist alerts to DB/web only) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_DEFAULT_TO_NUMBER=
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_DEFAULT_TO_NUMBER=
