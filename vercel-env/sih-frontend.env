# Vercel Project: sih (prj_eW4v7yQYJTT4Ksa0CT8tfxrwKlhI)
# Target: Production + Preview  (set both!)
# How to use: Vercel Dashboard -> sih -> Settings -> Environment Variables -> Add each KEY=VALUE, select Production+Preview, Save -> Redeploy
# IMPORTANT: Vite VITE_* vars are baked at BUILD TIME — you must REDEPLOY after adding them.

# Backend API — the NEW backend you just created. MUST be the full origin, no /api suffix.
# Example: https://sih-backend-ecru.vercel.app  (or https://sih-backend-mrinallsamal-bytes-projects.vercel.app)
VITE_API_URL=https://sih-backend-ecru.vercel.app

# AI Engine — same backend if you proxy AI, else FastAPI URL. Can be same as VITE_API_URL for now.
VITE_AI_URL=https://sih-backend-ecru.vercel.app

# Supabase Realtime (NEW project vpstgjkkvzqnspcivvpz) — get from https://supabase.com/dashboard/project/vpstgjkkvzqnspcivvpz/settings/api
VITE_SUPABASE_URL=https://vpstgjkkvzqnspcivvpz.supabase.co
# Get publishable anon key: Dashboard -> Settings -> API -> anon public key (or sb_publishable_...)
# Example from old project: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIs...
VITE_SUPABASE_ANON_KEY=PASTE_ANON_KEY_HERE_FROM_SUPABASE_DASHBOARD

# Mock mode — MUST be false in production, otherwise you only see demo data
VITE_USE_MOCK_ONLY=false

# Map
VITE_MAP_TILE_URL=https://mt{s}.google.com/vt/lyrs=m&x={x}&y={y}&z={z}
VITE_MAP_ATTRIBUTION=
