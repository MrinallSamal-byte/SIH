# ---- Server ----
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql://aapdasetu:aapdasetu@localhost:5432/aapdasetu?schema=public

# ---- Admin authentication ----
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=12h

# Admin bootstrap credentials (seeded once; change after first login)
ADMIN_EMAIL=admin@aapdasetu.org
ADMIN_PASSWORD=Admin@123

# ---- OpenRouter (PFA LLM chatbot) ----
# https://openrouter.ai/  — free tier models are used. Credentials provided later.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Free models: use something like "meta-llama/llama-3.1-8b-instruct:free" when available
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
PFA_ESCAPE_MODE=strict

# ---- Damage Assessment ML Service (FastAPI) ----
DAMAGE_ML_BASE_URL=http://localhost:8001
DAMAGE_ML_TIMEOUT_MS=30000

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Rate limiting ----
RATE_LIMIT_PUBLIC_WINDOW_MS=60000
RATE_LIMIT_PUBLIC_MAX=60
RATE_LIMIT_ADMIN_WINDOW_MS=900000
RATE_LIMIT_ADMIN_MAX=300

# ---- Realtime ----
REALTIME_PATH=/ws

# ---- Uploads ----
UPLOAD_MAX_SIZE_MB=15