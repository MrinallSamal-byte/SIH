
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


enum HELPTYPE {
  FOOD
  WATER
  MEDICAL
  RESCUE
  SHELTER
  OTHER
}

enum URGENCY {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}


enum STATUS {
  PENDING
  ACKNOWLEDGED
  ASSIGNED
  RESOLVED
  CANCELLED
}

enum ROLE {
  CITIZEN
  VOLUNTEER
  ADMIN
}

enum GENDER {
  MALE
  FEMALE
  OTHER
}

// Damage grade assigned by the AI model
enum DAMAGE_GRADE {
  MINOR        // Repairable, small cracks / broken windows
  MAJOR        // Significant structural damage, walls collapsed
  DESTROYED    // Total loss, not habitable
}

// Review status for the admin approval flow
enum REVIEW_STATUS {
  PENDING_REVIEW   // Just submitted, awaiting admin action
  APPROVED         // Admin approved the AI result, compensation authorised
  REJECTED         // Admin rejected — fraud or insufficient evidence
  NEEDS_REVISIT    // Flagged for physical re-survey
}

model user {
  id                  String      @id @default(uuid())
  name                String
  age                 Int
  phoneNumber         String      @unique
  role                ROLE        @default(CITIZEN)
  skills              String?    //only activate in times of Volunteer / admin
  lastKnownGPS        Float[]     @default([])
  createdRequests     sos[]       @relation("ReportedSOS") 
  assignedRequests    sos[]       @relation("AssignedSOS") 
  missingReports      MissingPerson[]
  shelterResidents    ShelterResident[] @relation("VolunteerShelterResidents")
  damageReports       DamageReport[]    @relation("DamageReports")
  reviewedReports     DamageReport[]    @relation("DamageReviews")
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
}


model sos {
  id                  String      @id @default(uuid())
  reporterId          String
  reporter            user        @relation("ReportedSOS", fields: [reporterId], references: [id], onDelete: Cascade)
  assignedToId        String?
  assignedTo          user?       @relation("AssignedSOS", fields: [assignedToId], references: [id], onDelete: SetNull)
  lastKnownGPS        Float[]
  helpType            HELPTYPE //can be replaced by video and audio ML model
  urgency             URGENCY  //can be replaced by PriorityScore
  peopleCount         Int
  hasChildren         Boolean     @default(false)
  hasElderly          Boolean     @default(false)
  hasDisabled         Boolean     @default(false)
  medicalNeed         Boolean     @default(false)
  desc                String?
  videoUrl            String
  audioUrl            String
  // isMeshRelayed       Boolean     @default(false)
  // relayedByDeviceId   String?
  status              STATUS      @default(PENDING)
  priorityScore       Float       @default(0)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([reporterId])
  @@index([assignedToId])
  @@index([status])
  @@index([priorityScore])
}


model MissingPerson {
  id          String @id @default(uuid())
  reporterId  String
  reporter    user   @relation(fields: [reporterId],references: [id], onDelete: Cascade)

  //about the person gone missing
  personName  String
  age         Int?
  gender      GENDER?
  photoUrl    String

  //about the reporter
  contactName   String
  contactPhone  String

  status        STATUS      @default(PENDING)
  shelter       String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([reporterId])
  @@index([status])
}

// ─── Damage Assessment ────────────────────────────────────────────────────────

model DamageReport {
  id                  String        @id @default(uuid())

  // Who filed the claim
  reporterId          String
  reporter            user          @relation("DamageReports", fields: [reporterId], references: [id], onDelete: Cascade)

  // Photo stored on Cloudinary
  photoUrl            String

  // ── EXIF-extracted metadata (verified by the Python service) ──────────────
  exifGpsLat          Float?        // Latitude from photo EXIF
  exifGpsLng          Float?        // Longitude from photo EXIF
  exifTimestamp       DateTime?     // DateTimeOriginal from EXIF
  exifMake            String?       // Camera make (e.g. "Apple")
  exifModel           String?       // Camera model (e.g. "iPhone 14")
  gpsVerified         Boolean       @default(false)  // true when EXIF GPS matches claimed location
  timestampVerified   Boolean       @default(false)  // true when EXIF time is post-disaster

  // ── Fraud detection ───────────────────────────────────────────────────────
  pHash               String?       // 64-bit perceptual hash of the image
  isDuplicate         Boolean       @default(false)   // set if pHash matches an existing claim
  duplicateOfId       String?       // ID of the original claim if duplicate

  // ── AI damage classification (ResNet50) ───────────────────────────────────
  damageGrade         DAMAGE_GRADE?                   // MINOR / MAJOR / DESTROYED
  confidenceScore     Float?                          // model softmax confidence 0–1
  aiDescription       String?                         // short text explanation from AI

  // ── Compensation ─────────────────────────────────────────────────────────
  compensationAmount  Float?        // auto-calculated in INR based on damage grade
  propertyType        String?       // "RESIDENTIAL" | "COMMERCIAL" | "AGRICULTURAL"
  ownershipProof      String?       // optional doc URL (Aadhaar-linked property)

  // ── Claimed location (user-supplied, cross-checked against EXIF) ──────────
  claimedGpsLat       Float
  claimedGpsLng       Float
  disasterZoneId      String?       // optional FK to a disaster event

  // ── Admin review ─────────────────────────────────────────────────────────
  reviewStatus        REVIEW_STATUS @default(PENDING_REVIEW)
  reviewedById        String?
  reviewedBy          user?         @relation("DamageReviews", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNote          String?
  reviewedAt          DateTime?

  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([reporterId])
  @@index([reviewStatus])
  @@index([damageGrade])
  @@index([pHash])
  @@index([isDuplicate])
}

model ShelterResident {
  id                String   @id @default(uuid())
  volunteerId       String
  volunteer         user     @relation("VolunteerShelterResidents", fields: [volunteerId], references: [id], onDelete: Cascade)
  residentName      String
  age               Int?
  gender            GENDER?
  contactPhone      String?
  shelterName       String
  notes             String?
  isMatchConfirmed  Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([volunteerId])
  @@index([residentName])
  @@index([shelterName])
}
